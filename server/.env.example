# Copy this file to .env and adjust the values:
#   cp server/.env.example server/.env

# Port the Express API listens on.
# Note: 5000 is reserved by Windows (via Hyper-V/WinNAT) on some machines,
# so this project uses 5005 — which the client code expects.
PORT=5005

# MySQL / MariaDB connection (defaults match the bundled DevKit MariaDB)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=thera_kids

# Secret used to sign admin JWTs. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
