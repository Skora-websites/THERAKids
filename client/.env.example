# Copy this file to .env and adjust the values:
#   cp client/.env.example client/.env
# Variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5005

# WhatsApp number that receives appointment requests (country code, no +)
VITE_WHATSAPP_NUMBER=919899338813

# Google Apps Script Web App /exec URL that appends newsletter subscribers to a
# Google Sheet. Submissions go browser → Google directly; nothing is stored on
# this website's server. Leave unset to use the built-in dummy endpoint.
VITE_NEWSLETTER_ENDPOINT=

# Google Forms for the home-page lead popup (free screening funnel). The popup
# appears ~10s after the home page opens, on every load, and hands visitors off
# to these forms (handled directly by the reception team).
VITE_FREE_ASSESSMENT_FORM=
VITE_ONLINE_THERAPY_FORM=
